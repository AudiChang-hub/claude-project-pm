{
  "name": "project-pm",
  "version": "1.2.1",
  "description": "A PM for AI coding sessions: a ledger of the work, a QA gate before it closes, and a board of where every session stands, served over MCP to any AI coding tool.",
  "license": "MIT",
  "repository": "https://github.com/AudiChang-hub/claude-project-pm",
  "type": "module",
  "bin": {
    "project-pm": "dist/project-pm.cjs"
  },
  "files": [
    "dist/project-pm.cjs",
    "README.md",
    "README.zh-TW.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --import tsx --test \"test/*.spec.ts\"",
    "typecheck": "node scripts/web-assets.mjs && tsc --noEmit",
    "build": "node scripts/build.mjs",
    "sea": "node scripts/sea.mjs",
    "pretest": "node scripts/web-assets.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "postject": "1.0.0-alpha.6",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "yaml": "2.9.1"
  }
}
